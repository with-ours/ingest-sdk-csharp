<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>

    <!-- Run tests on net8.0, which will use the SDK's net8.0 DLL, and on net472, which will use the
    SDK's netstandard2.0 DLL. -->
    <TargetFrameworks>net8.0;net472</TargetFrameworks>

    <!-- Disable skipped tests warnings. -->
    <NoWarn>$(NoWarn),xUnit1004</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageReference Include="xunit.analyzers" Version="2.2.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <ProjectReference Include="..\OursPrivacy\OursPrivacy.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <!-- Previously referenced transitively via Microsoft.Testing.Platform; xunit.v3.mtp-off does not. -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>
</Project>