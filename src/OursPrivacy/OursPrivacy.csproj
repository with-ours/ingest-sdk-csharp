<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Metadata -->
    <AssemblyTitle>Ours Privacy C#</AssemblyTitle>
    <AssemblyName>OursPrivacy</AssemblyName>
    <VersionPrefix>1.29.0</VersionPrefix>
    <Description>The official .NET library for the Ours Privacy API.</Description>
    <OutputType>Library</OutputType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OursPrivacy.Tests"/>
    <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
    <PackageReference Include="System.Text.Json" Version="10.0.14"/>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Collections.Immutable" Version="10.0.14"/>
  </ItemGroup>
</Project>